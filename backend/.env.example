# Comma-separated list of frontend origins allowed to call this API in production.
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# Maximum number of characters accepted per analysis request.
MAX_TEXT_LENGTH=20000

# Minimum number of characters required for a reliable analysis.
MIN_TEXT_LENGTH=50

# Hugging Face model used for pseudo-perplexity. Must be a masked language model.
PERPLEXITY_MODEL_NAME=xlm-roberta-base

# Device for transformer inference: "cpu" or "cuda"
INFERENCE_DEVICE=cpu

# Directory (relative to backend/) where trained model artifacts are stored.
MODEL_DIR=models

# Uvicorn port. Render supplies this automatically via $PORT.
PORT=8000
